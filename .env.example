# Copia a .env (no se versiona) o define estas variables en el hosting.
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://postgres@localhost:5432/despacho
SITIO_URL=http://localhost:8000

# Archivos PDF (DigitalOcean Spaces u otro S3). Si se omite, se guardan en ./media
S3_BUCKET=
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Correo del sistema (Resend por SMTP). Si se omite, los correos se imprimen en consola.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Despacho <sistema@tudespacho.mx>

# Respaldos externos (Backblaze B2, API compatible con S3)
RESPALDO_BUCKET=
RESPALDO_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
RESPALDO_ACCESS_KEY=
RESPALDO_SECRET_KEY=
